  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=36><color=#E69F00><b>LECTURER & LEARNER AR GUIDE (SE2010)</b></color></size>\n\n<color=#38BDF8><b>1. 15-MINUTE STRUCTURED LESSON PLAN</b></color>\n\u2022 <b>00\u201303 Min (Pre-Test):</b> Open Quiz and complete the 20 baseline SDLC scenario questions.\n\u2022 <b>03\u201306 Min (Scene 1 & 2):</b> Compare linear Waterfall staircase vs. circular Agile Scrum loop. Press <b>Inject</b> at Step 4 to observe rework cost (+100h vs +5h).\n\u2022 <b>06\u201309 Min (Scene 3 & 4):</b> Inspect Kanban WIP Limit (max 2 cards) and CI/CD Automated Unit Test gates.\n\u2022 <b>09\u201312 Min (Scene 5):</b> Evaluate the 60% Requirement Pivot side-by-side 3D bar chart (125h vs 15h).\n\u2022 <b>12\u201315 Min (Post-Test):</b> Click <b>Retake Quiz</b> to verify >= +20% normalized learning gain.\n\n<color=#009E73><b>2. PRINTABLE 10x10 CM AR MARKER CARDS</b></color>\n\u2022 <b>Marker 1 (WATERFALL SDLC):</b> Blue geometric cascade card (10 cm physical width).\n\u2022 <b>Marker 2 (AGILE SCRUM):</b> Amber & Emerald iterative sprint loop card (10 cm width).\n\u2022 <b>Controls:</b> Tap surface to spawn stage, drag with 1 finger to rotate 360\xB0, use top slider to scale."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
